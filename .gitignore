# Harness System .gitignore

# ===========================================
# Environment & Secrets
# ===========================================
.env
.env.local
.env.*.local
*.pem
*.key
secrets/

# ===========================================
# Python
# ===========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
ENV/
env/
.venv/

# ===========================================
# IDE & Editors
# ===========================================
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# ===========================================
# Testing & Coverage
# ===========================================
.coverage
.pytest_cache/
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
.hypothesis/

# ===========================================
# Type Checking & Linting
# ===========================================
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json

# ===========================================
# Logs (Keep directory, ignore contents)
# ===========================================
logs/*.json
logs/*.log
!logs/.gitkeep

# Founder Harness logs
founder_harness/logs/*.json
founder_harness/logs/*.log
!founder_harness/logs/.gitkeep

# ===========================================
# OS Generated
# ===========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ===========================================
# Temporary Files
# ===========================================
*.tmp
*.temp
*.bak
*.backup
