# Harness System Configuration
# Copy this file to .env and fill in your values

# ===========================================
# LLM API Configuration (Choose One)
# ===========================================

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4

# Anthropic Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-opus-20240229

# ===========================================
# Harness Configuration
# ===========================================

# Operating mode: shadow (default) or production
HARNESS_MODE=shadow

# Path configurations (relative to project root)
CONTEXT_PATH=context
LOGS_PATH=logs

# ===========================================
# Security & Compliance
# ===========================================

# Enable/disable logging of sensitive data
LOG_SENSITIVE_DATA=false

# Maximum log retention in days
LOG_RETENTION_DAYS=90

# ===========================================
# Development Settings
# ===========================================

# Debug mode (enables verbose logging)
DEBUG=false

# Environment: development, staging, production
ENVIRONMENT=development
